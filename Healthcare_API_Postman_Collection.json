{
  "info": {
    "_postman_id": "healthcare-backend-api-collection",
    "name": "Healthcare Backend System API",
    "description": "Complete Postman collection for the Healthcare Backend System built with Django, Django REST Framework, SimpleJWT, and PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Jane Foster\",\n  \"email\": \"jane.foster@hospital.org\",\n  \"password\": \"SecurePass123!\",\n  \"password2\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Register a new user account with name, email, and password."
          }
        },
        {
          "name": "Login (Obtain JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.environment.set(\"access_token\", jsonData.access);",
                  "    pm.environment.set(\"refresh_token\", jsonData.refresh);",
                  "    console.log(\"Saved access_token to environment.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.foster@hospital.org\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Log in with email and password. Automatically stores access_token in Postman environment."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            },
            "description": "Obtain a fresh access token using the refresh token."
          }
        }
      ]
    },
    {
      "name": "2. Patients",
      "item": [
        {
          "name": "List User's Patients",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Retrieve all patients created by the authenticated user."
          }
        },
        {
          "name": "Add New Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"patient_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Peter Parker\",\n  \"date_of_birth\": \"2001-08-10\",\n  \"gender\": \"Male\",\n  \"contact_number\": \"+919876543210\",\n  \"medical_history\": \"Spider bite, enhanced metabolism\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Add a new patient. Auto-associates patient with authenticated user."
          }
        },
        {
          "name": "Get Specific Patient",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            },
            "description": "Get details of a specific patient by ID."
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Peter Parker (Updated)\",\n  \"date_of_birth\": \"2001-08-10\",\n  \"gender\": \"Male\",\n  \"contact_number\": \"+919876543210\",\n  \"medical_history\": \"Mild allergy to dust, otherwise healthy\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            },
            "description": "Update patient details."
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            },
            "description": "Delete a patient record."
          }
        }
      ]
    },
    {
      "name": "3. Doctors",
      "item": [
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", ""]
            },
            "description": "Retrieve all registered doctors."
          }
        },
        {
          "name": "Add New Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"doctor_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stephen Strange\",\n  \"specialization\": \"Neuro-Surgery\",\n  \"contact_number\": \"+919988776655\",\n  \"email\": \"dr.strange@sanctum.org\",\n  \"years_of_experience\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", ""]
            },
            "description": "Add a new doctor (Authenticated users only)."
          }
        },
        {
          "name": "Get Specific Doctor",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            },
            "description": "Get details of a specific doctor by ID."
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stephen Strange, MD, PhD\",\n  \"specialization\": \"Neurosurgery & Mystic Arts\",\n  \"contact_number\": \"+919988776655\",\n  \"email\": \"dr.strange@sanctum.org\",\n  \"years_of_experience\": 16\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            },
            "description": "Update doctor details."
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            },
            "description": "Delete a doctor record."
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mappings",
      "item": [
        {
          "name": "List All Mappings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            },
            "description": "Retrieve all patient-doctor mappings."
          }
        },
        {
          "name": "Assign Doctor to Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"mapping_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": {{patient_id}},\n  \"doctor_id\": {{doctor_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            },
            "description": "Assign a doctor to a patient."
          }
        },
        {
          "name": "Get Doctors for Specific Patient",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "{{patient_id}}", ""]
            },
            "description": "Get all doctors assigned to a specific patient."
          }
        },
        {
          "name": "Remove Doctor from Patient",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{mapping_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "{{mapping_id}}", ""]
            },
            "description": "Remove an assigned doctor from a patient by mapping ID."
          }
        }
      ]
    }
  ]
}
